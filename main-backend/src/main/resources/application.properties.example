spring.application.name=main-backend

# ==========================================
# 1. Database Configuration
# ==========================================
# For local dev with IntelliJ & Docker Compose, use localhost.
# For full Docker/AWS deployment, use the container name, e.g., jdbc:mysql://db:3306/...
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/main_backend_db?createDatabaseIfNotExist=true&serverTimezone=UTC}
spring.datasource.username=root
# REQUIRED: Set via environment variable DB_PASSWORD
spring.datasource.password=${DB_PASSWORD:YOUR_DB_PASSWORD}

# Hibernate configuration (Use 'update' or 'validate' for prod)
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Dialect for MySQL
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ==========================================
# 2. Server Configuration
# ==========================================
server.port=8080

# ==========================================
# 3. Security & JWT Configuration
# ==========================================
# REQUIRED: Generate with `openssl rand -base64 32` and set via environment variable JWT_SECRET
# Must be at least 32 characters long
jwt.secret=${JWT_SECRET:YOUR_JWT_SECRET_MIN_32_CHARS}
jwt.access-token-expiration=900000
jwt.refresh-token-expiration=604800000
jwt.cache-maximum-size=100000

# Rate Limiting Configuration
app.security.rate-limit.capacity=100
app.security.rate-limit.time-unit-minutes=1
app.security.rate-limit.cache-expiration-minutes=60
app.security.rate-limit.cache-maximum-size=100000

# Enable scheduling for token cleanup
spring.main.allow-bean-definition-overriding=true

# Development Mode
# IMPORTANT: Set to false in production to enable full authentication/authorization
app.development-mode=true

# ==========================================
# 4. Algorithm Service Integration
# ==========================================
# Algorithm service URL — set via environment variable ALGO_SERVICE_URL in production
algorithm.service.url=${ALGO_SERVICE_URL:http://localhost:8081}