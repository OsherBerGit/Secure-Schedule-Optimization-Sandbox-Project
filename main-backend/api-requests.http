### Server API Tests - SIMPLE COPY-PASTE VERSION
### Save this file as: api-requests.http
### Use with IntelliJ IDEA Ultimate HTTP Client

### INSTRUCTIONS:
### 1. Run MainBackendApplication to start the server
### 2. Open this file in IntelliJ IDEA Ultimate
### 3. Click the "Run" icon next to each request to execute it

### Variables
@baseUrl = http://localhost:8080
@contentType = application/json

### ==================== PUBLIC ENDPOINTS ====================

### GET request to server status (public - no auth required)
GET {{baseUrl}}/api/status
Accept: {{contentType}}

### ==================== AUTHENTICATION ====================

### Login as ADMIN - Get access token and refresh token
### Credentials: teudatZehut=admin, password=admin (has ADMIN + USER roles)
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}

{
  "teudatZehut": "admin",
  "password": "admin"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### Login as USER - Get access token and refresh token
### Credentials: teudatZehut=user, password=user (has USER role only)
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}

{
  "teudatZehut": "user",
  "password": "user"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### Refresh Token - Get new access token using refresh token
POST {{baseUrl}}/api/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### Logout - Blacklist the current token
### NOTE: The correct URL is /api/auth/logout (not /api/logout)
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}

### ==================== PROTECTED ENDPOINTS ====================

### GET request to fetch all users (requires authentication + USER or ADMIN role)
GET {{baseUrl}}/api/users
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET request to fetch a specific user by ID
GET {{baseUrl}}/api/users/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET user by Teudat Zehut
GET {{baseUrl}}/api/users/teudat-zehut/123456789
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET user by Email
GET {{baseUrl}}/api/users/email/test@example.com
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Create a new user (requires ADMIN role)
POST {{baseUrl}}/api/users
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "nationalId": "987654321",
  "password": "newpassword123",
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@example.com",
  "phoneNumber": "0501234567",
  "salary": 10000.0,
  "address": "123 Main St",
  "dailyAvailabilityHours": 8,
  "maxTasks": 5
}

### Update a user (requires ADMIN role)
PUT {{baseUrl}}/api/users/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "nationalId": "123456789",
  "firstName": "Updated",
  "lastName": "User",
  "email": "updated@example.com",
  "phoneNumber": "0509876543"
}

### Delete a user (requires ADMIN role)
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{accessToken}}

### ==================== TASK ENDPOINTS ====================

### GET all tasks
GET {{baseUrl}}/api/tasks
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET task by ID
GET {{baseUrl}}/api/tasks/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET tasks by worker ID
GET {{baseUrl}}/api/tasks/worker/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### GET tasks by status name
GET {{baseUrl}}/api/tasks/status/Pending
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Create a new task (requires ADMIN role)
POST {{baseUrl}}/api/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "Complete Project Documentation",
  "description": "Write comprehensive documentation for the project",
  "deadline": "2026-03-15T17:00:00",
  "durationHours": 8,
  "priorityId": 1,
  "statusId": 1,
  "assignedWorkerId": 1
}

### Create a task without assigned worker
POST {{baseUrl}}/api/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "Code Review",
  "description": "Review pull requests",
  "deadline": "2026-02-10T12:00:00",
  "durationHours": 4,
  "priorityId": 2,
  "statusId": 1,
  "assignedWorkerId": null
}

### Update a task (requires ADMIN role)
PUT {{baseUrl}}/api/tasks/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "Updated Task Title",
  "description": "Updated task description",
  "deadline": "2026-03-20T18:00:00",
  "durationHours": 10,
  "priorityId": 1,
  "statusId": 2,
  "assignedWorkerId": 2
}

### Delete a task (requires ADMIN role)
DELETE {{baseUrl}}/api/tasks/1
Authorization: Bearer {{accessToken}}

### ==================== TASK CONSTRAINTS (Dependencies) ====================

### Get all task constraints (any authenticated user)
GET {{baseUrl}}/api/task-constraints
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get task constraint by ID
GET {{baseUrl}}/api/task-constraints/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get constraints where task is predecessor (tasks that depend on this one)
GET {{baseUrl}}/api/task-constraints/predecessor/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get constraints where task is successor (tasks that this one depends on)
GET {{baseUrl}}/api/task-constraints/successor/2
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Create a task constraint (requires ADMIN role)
### Example: Task 2 cannot start until Task 1 finishes
POST {{baseUrl}}/api/task-constraints
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "predecessorTaskId": 1,
  "successorTaskId": 2,
  "constraintTypeId": 1,
  "lagMinutes": 0
}

### Create a task constraint with lag time (30 minutes delay)
POST {{baseUrl}}/api/task-constraints
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "predecessorTaskId": 2,
  "successorTaskId": 3,
  "constraintTypeId": 1,
  "lagMinutes": 30
}

### Update a task constraint (requires ADMIN role)
PUT {{baseUrl}}/api/task-constraints/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "predecessorTaskId": 1,
  "successorTaskId": 2,
  "constraintTypeId": 1,
  "lagMinutes": 15
}

### Delete a task constraint (requires ADMIN role)
DELETE {{baseUrl}}/api/task-constraints/1
Authorization: Bearer {{accessToken}}

### Test circular dependency prevention (should return 400 error)
### Example: If constraint 1->2 and 2->3 exist, trying to add 3->1 should fail
POST {{baseUrl}}/api/task-constraints
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "predecessorTaskId": 3,
  "successorTaskId": 1,
  "constraintTypeId": 1,
  "lagMinutes": 0
}

### Test self-reference prevention (should return 400 error)
POST {{baseUrl}}/api/task-constraints
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "predecessorTaskId": 1,
  "successorTaskId": 1,
  "constraintTypeId": 1,
  "lagMinutes": 0
}

### ==================== VACATIONS (Worker Unavailability) ====================

### Get all vacations (any authenticated user)
GET {{baseUrl}}/api/vacations
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get vacation by ID
GET {{baseUrl}}/api/vacations/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get vacations by worker ID
GET {{baseUrl}}/api/vacations/worker/1
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Get vacations by date range
GET {{baseUrl}}/api/vacations/date-range?startDate=2026-03-01&endDate=2026-03-31
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Create a vacation (requires ADMIN role)
POST {{baseUrl}}/api/vacations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 1,
  "startDate": "2026-03-15",
  "endDate": "2026-03-20"
}

### Create another vacation
POST {{baseUrl}}/api/vacations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 2,
  "startDate": "2026-04-01",
  "endDate": "2026-04-05"
}

### Update a vacation (requires ADMIN role)
PUT {{baseUrl}}/api/vacations/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 1,
  "startDate": "2026-03-16",
  "endDate": "2026-03-22"
}

### Delete a vacation (requires ADMIN role)
DELETE {{baseUrl}}/api/vacations/1
Authorization: Bearer {{accessToken}}

### Test overlapping vacation prevention (should return 400 error)
### First create vacation: 2026-03-15 to 2026-03-20
### Then try to create: 2026-03-18 to 2026-03-25 (overlaps)
POST {{baseUrl}}/api/vacations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 1,
  "startDate": "2026-03-18",
  "endDate": "2026-03-25"
}

### Test past date prevention (should return 400 error)
POST {{baseUrl}}/api/vacations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 1,
  "startDate": "2020-01-01",
  "endDate": "2020-01-05"
}

### Test invalid date range (should return 400 error)
POST {{baseUrl}}/api/vacations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "workerId": 1,
  "startDate": "2026-03-25",
  "endDate": "2026-03-20"
}

### ==================== TEST SCENARIOS ====================

### Test with invalid token (should return 401)
GET {{baseUrl}}/api/users
Accept: {{contentType}}
Authorization: Bearer invalid_token_here

### Test without token (should return 401)
GET {{baseUrl}}/api/users
Accept: {{contentType}}
