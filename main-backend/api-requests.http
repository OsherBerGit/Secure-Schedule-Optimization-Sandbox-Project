  ]
}

### ✅ Predecessor dependency — task 2 starts after task 1 finishes
POST {{sideUrl}}/api/v1/algo/schedule
Content-Type: {{contentType}}

{
  "strategy": "GREEDY",
  "users": [
    {
      "id": 1,
      "firstName": "Alice",
      "lastName": "Smith",
      "email": "alice@example.com",
      "dailyAvailabilityHours": 8,
      "maxTasks": 10,
      "roles": ["WORKER"],
      "vacations": []
    }
  ],
  "tasks": [
    {
      "id": 1,
      "title": "Backend API",
      "durationHours": 8,
      "deadline": "2026-12-31T23:59:59",
      "priority": "HIGH",
      "priorityLevel": 3,
      "status": "PENDING",
      "requiredRoles": ["WORKER"],
      "predecessorTaskIds": [],
